<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="UsbGScope.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:UsbGScope.App.ViewModels"
    xmlns:pres="using:UsbGScope.Core.Presentation"
    Title="USB_G-Scope">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,*,Auto">
        <Grid.Resources>
            <MenuFlyout x:Key="NodeContextMenu" Opening="NodeContextMenu_Opening">
                <MenuFlyoutItem Tag="SetAlias" Text="Set nickname…" Click="SetNickname_Click"
                                KeyboardAcceleratorTextOverride="F2">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Tag="RemoveAlias" Text="Remove nickname" Click="RemoveNickname_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Copy details" Click="Copy_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+Shift+C">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>

            <MenuFlyout x:Key="DetailRowContextMenu">
                <MenuFlyoutItem Text="Copy value" Click="CopyDetailValue_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>

            <DataTemplate x:Key="NodeRowTemplate" x:DataType="vm:UsbNodeViewModel">
                <Grid ColumnSpacing="10" Padding="0,5,14,5" Opacity="{x:Bind ContentOpacity}"
                      ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                      ContextFlyout="{StaticResource NodeContextMenu}"
                      RightTapped="NodeRow_RightTapped"
                      ContextRequested="NodeRow_ContextRequested">
                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <Border Visibility="{x:Bind AliasBadgeVisibility}" CornerRadius="3" Padding="4,1"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Custom nickname">
                                <TextBlock Text="alias" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{x:Bind Subtitle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ItemsControl Grid.Column="2" ItemsSource="{x:Bind Badges}" IsTabStop="False"
                                  VerticalAlignment="Center" Visibility="{x:Bind BadgesVisibility}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border CornerRadius="4" Padding="5,0" BorderThickness="1"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}">
                                    <TextBlock Text="{x:Bind}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <FontIcon Grid.Column="3" Glyph="&#xE7BA;" FontSize="14" VerticalAlignment="Center"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}"
                              Visibility="{x:Bind WarningVisibility}"
                              ToolTipService.ToolTip="{x:Bind Warning}" />
                    <Border Grid.Column="4" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                            Background="{x:Bind SpeedBrush}" Visibility="{x:Bind SpeedVisibility}">
                        <TextBlock Text="{x:Bind SpeedBadge}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusSearch_Invoked" />
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveJson_Invoked" />
            <KeyboardAccelerator Key="F2" Invoked="Rename_Invoked" />
        </Grid.KeyboardAccelerators>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Height="48" Padding="16,0" ColumnSpacing="12" ColumnDefinitions="Auto,*">
            <FontIcon Glyph="&#xE88E;" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="USB_G-Scope" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Padding="16,0,16,12" ColumnSpacing="12" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto">
            <Button x:Name="RefreshButton" Click="Refresh_Click" ToolTipService.ToolTip="Refresh (F5)">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5" />
                </Button.KeyboardAccelerators>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" Width="280" VerticalAlignment="Center"
                            PlaceholderText="Search name, VID:PID, drive, COM…" QueryIcon="Find"
                            TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"
                            AutomationProperties.Name="Search devices"
                            ToolTipService.ToolTip="Search (Ctrl+F). All words must match." />
            <ToggleButton x:Name="IssuesToggle" Grid.Column="2" Click="IssuesToggle_Click" Visibility="Collapsed"
                          ToolTipService.ToolTip="Show only devices with warnings">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    <TextBlock x:Name="IssuesLabel" Text="Issues" />
                </StackPanel>
            </ToggleButton>
            <CheckBox x:Name="ShowEmptyPorts" Grid.Column="3" Content="Show empty ports" Click="ShowEmptyPorts_Click" />
            <CheckBox x:Name="LiveUpdates" Grid.Column="4" Content="Live updates" IsChecked="True" Click="LiveUpdates_Click"
                      ToolTipService.ToolTip="Refresh automatically when USB devices are connected or removed" />
            <ProgressRing x:Name="Busy" Grid.Column="6" Width="16" Height="16" IsActive="False" />
            <DropDownButton Grid.Column="7" ToolTipService.ToolTip="Save the current snapshot as JSON"
                            AutomationProperties.Name="Export">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                    <TextBlock Text="Export" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Text="Save JSON…" Click="ExportJson_Click" KeyboardAcceleratorTextOverride="Ctrl+S">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Save JSON with serials masked…" Click="ExportJsonMasked_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72E;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <Button Grid.Column="8" ToolTipService.ToolTip="Appearance" AutomationProperties.Name="Appearance">
                <FontIcon Glyph="&#xE790;" FontSize="14" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <RadioMenuFlyoutItem x:Name="ThemeSystem" Text="Use system setting" GroupName="Theme" Tag="System" Click="Theme_Click" />
                        <RadioMenuFlyoutItem x:Name="ThemeLight" Text="Light" GroupName="Theme" Tag="Light" Click="Theme_Click" />
                        <RadioMenuFlyoutItem x:Name="ThemeDark" Text="Dark" GroupName="Theme" Tag="Dark" Click="Theme_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="2" Padding="16,0,16,8" ColumnSpacing="16" RowSpacing="12" RowDefinitions="Auto,*">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="320" />
                <ColumnDefinition Width="6*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.ColumnSpan="2">
                <InfoBar x:Name="LoadError" Severity="Error" IsClosable="True"
                         Title="Could not read USB devices" />
                <InfoBar x:Name="ChangeBar" Severity="Informational" IsClosable="True" />
            </StackPanel>

            <!-- Device tree -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="4,8">
                <Grid>
                <TextBlock x:Name="NoMatches" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="24"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TreeView x:Name="DeviceTree" SelectionMode="Single" CanDragItems="False" CanReorderItems="False"
                          AllowDrop="False" SelectionChanged="DeviceTree_SelectionChanged"
                          Expanding="DeviceTree_Expanding" Collapsed="DeviceTree_Collapsed"
                          AutomationProperties.Name="USB device tree">
                    <TreeView.ItemTemplate>
                        <!-- Node mode: expansion is controlled in code (RebuildTree); see NodeRowTemplate for the row. -->
                        <DataTemplate x:DataType="TreeViewNode">
                            <TreeViewItem AutomationProperties.Name="{x:Bind ((vm:UsbNodeViewModel)Content).AccessibleName}">
                                <ContentControl Content="{x:Bind Content}" ContentTemplate="{StaticResource NodeRowTemplate}"
                                                IsTabStop="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" />
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                </Grid>
            </Border>

            <!-- Details -->
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <StackPanel x:Name="EmptyDetails" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                        <FontIcon Glyph="&#xE88E;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Select a device to see its details" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ScrollViewer x:Name="DetailsScroller" Visibility="Collapsed" Padding="24,20,24,20">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="16" ColumnDefinitions="Auto,*,Auto">
                                <Border Width="52" Height="52" CornerRadius="10"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <FontIcon x:Name="DetailGlyph" FontSize="26" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:Name="DetailTitle" Style="{StaticResource SubtitleTextBlockStyle}"
                                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" VerticalAlignment="Center" />
                                        <Button x:Name="EditAliasButton" Click="EditAlias_Click" Padding="4,2"
                                                Background="Transparent" BorderThickness="0"
                                                ToolTipService.ToolTip="Set nickname (F2)" AutomationProperties.Name="Set nickname">
                                            <FontIcon Glyph="&#xE70F;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Button>
                                    </StackPanel>
                                    <TextBlock x:Name="DetailSubtitle" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button x:Name="CopyButton" Grid.Column="2" VerticalAlignment="Top" Click="Copy_Click"
                                        ToolTipService.ToolTip="Copy all details as text (Ctrl+Shift+C)">
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="C" Modifiers="Control,Shift" />
                                    </Button.KeyboardAccelerators>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                        <TextBlock x:Name="CopyLabel" Text="Copy" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <InfoBar x:Name="DetailWarning" Severity="Warning" IsClosable="False" />

                            <ItemsControl x:Name="DetailSections" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="pres:DetailSection">
                                        <StackPanel Spacing="6" Margin="0,0,0,18">
                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <ItemsControl ItemsSource="{x:Bind Rows}" IsTabStop="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="pres:DetailRow">
                                                        <Grid ColumnSpacing="16" Padding="0,3" ColumnDefinitions="170,*"
                                                              ContextFlyout="{StaticResource DetailRowContextMenu}">
                                                            <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap"
                                                                       IsTextSelectionEnabled="True" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Expander x:Name="RawExpander" Header="Raw descriptors"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <TextBlock x:Name="RawText" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                           IsTextSelectionEnabled="True" TextWrapping="NoWrap" />
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status line -->
        <Grid Grid.Row="3" Margin="20,0,20,10" ColumnDefinitions="*,Auto">
            <TextBlock x:Name="SummaryText" TextTrimming="CharacterEllipsis"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="1" Text="F5 Refresh  ·  Ctrl+F Search  ·  F2 Nickname  ·  Ctrl+S Export  ·  Ctrl+Shift+C Copy"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</Window>
